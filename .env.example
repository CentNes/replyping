# Required in production
NODE_ENV=production
JWT_SECRET=generate-a-random-64-char-string-here
PORT=3000

# Meta APIs (required for real Instagram/WhatsApp integration)
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_PAGE_ID=
META_APP_SECRET=
WEBHOOK_VERIFY_TOKEN=pick-a-random-string

# Stripe (required for real billing)
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=
STRIPE_WEBHOOK_SECRET=

# Email (Resend — for password resets and notifications)
RESEND_API_KEY=
EMAIL_FROM=ReplyPing <noreply@yourdomain.com>
APP_URL=https://yourdomain.com

# Database (Railway persistent volume)
DATABASE_PATH=/data/replyping.db

# CORS origin (your frontend domain in production)
CORS_ORIGIN=https://yourdomain.com
